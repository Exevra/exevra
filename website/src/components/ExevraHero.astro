---
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="exevra-hero">
  <div class="exevra-hero__copy">
    <p class="exevra-hero__eyebrow">Test execution integrity</p>
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="exevra-hero__tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="exevra-hero__actions">
          {actions.map(({ link, text, variant }) => (
            <a class:list={{ "exevra-hero__action": true, "exevra-hero__action--minimal": variant === "minimal" }} href={link}>
              {text}
            </a>
          ))}
        </div>
      )
    }
  </div>

  <div class="exevra-hero__mark" aria-hidden="true">
    <svg viewBox="0 0 32 32" focusable="false">
      <path class="trace-layer trace-layer--back trace-mark--back" d="m5 10 6-3 15 11-6 3Z" />
      <path class="trace-layer trace-layer--front trace-mark--front" d="m5 17 6-3 15 11-6 3Z" />
      <path class="trace-layer trace-layer--middle trace-mark--middle" d="m11 13 6-3 9 7-6 3Z" />
    </svg>
  </div>
</div>

<style>
  .exevra-hero {
    --exevra-mark-back: #79d9cd;
    --exevra-mark-front: #e7fffb;
    --exevra-mark-middle: #22ad9c;
    display: grid;
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: center;
    padding-block: clamp(1rem, 4vw, 3rem);
  }

  :global(:root[data-theme='light']) .exevra-hero {
    --exevra-mark-back: #8de0d5;
    --exevra-mark-front: #0d2523;
    --exevra-mark-middle: #199b8c;
  }

  .exevra-hero__copy {
    max-width: 42rem;
  }

  .exevra-hero__eyebrow {
    margin: 0 0 1rem;
    color: var(--sl-color-accent);
    font-size: var(--sl-text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: clamp(3rem, 11vw, 7.5rem);
    font-weight: 800;
    letter-spacing: -0.09em;
    line-height: 0.9;
  }

  :global(.exevra-wordmark) {
    display: inline-block;
  }

  :global(.exevra-wordmark__accent) {
    color: var(--sl-color-accent);
  }

  .exevra-hero__tagline {
    max-width: 37rem;
    margin: 1.5rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: clamp(var(--sl-text-lg), 2vw, var(--sl-text-2xl));
    line-height: 1.35;
  }

  .exevra-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .exevra-hero__action {
    border-radius: 0.5rem;
    padding: 0.7rem 1rem;
    color: var(--sl-color-text-invert);
    background: var(--sl-color-accent-high);
    font-weight: 700;
    text-decoration: none;
  }

  .exevra-hero__action:hover {
    color: var(--sl-color-text-invert);
    background: var(--sl-color-accent);
  }

  .exevra-hero__action--minimal {
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
    background: transparent;
  }

  .exevra-hero__action--minimal:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-3);
    background: transparent;
  }

  .exevra-hero__mark {
    width: min(17rem, 64vw);
    justify-self: center;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 1.5rem 2rem color-mix(in srgb, var(--sl-color-accent-low), transparent 45%));
  }

  .trace-layer {
    transform-box: fill-box;
    transform-origin: center;
  }

  .trace-mark--back {
    fill: var(--exevra-mark-back);
  }

  .trace-mark--front {
    fill: var(--exevra-mark-front);
  }

  .trace-mark--middle {
    fill: var(--exevra-mark-middle);
  }

  .trace-layer--back {
    animation: trace-arrive-back 720ms cubic-bezier(0.16, 0.9, 0.22, 1) both;
  }

  .trace-layer--middle {
    animation: trace-arrive-middle 720ms 70ms cubic-bezier(0.16, 0.9, 0.22, 1) both;
  }

  .trace-layer--front {
    animation: trace-arrive-front 720ms 130ms cubic-bezier(0.16, 0.9, 0.22, 1) both;
  }

  @keyframes trace-arrive-back {
    from {
      opacity: 0;
      transform: translate(-18px, -8px);
    }
    to {
      opacity: 1;
      transform: translate(0, 0);
    }
  }

  @keyframes trace-arrive-middle {
    from {
      opacity: 0;
      transform: translate(10px, -4px);
    }
    to {
      opacity: 1;
      transform: translate(0, 0);
    }
  }

  @keyframes trace-arrive-front {
    from {
      opacity: 0;
      transform: translate(-12px, 10px);
    }
    to {
      opacity: 1;
      transform: translate(0, 0);
    }
  }

  @media (min-width: 50rem) {
    .exevra-hero {
      grid-template-columns: minmax(0, 1.3fr) minmax(14rem, 0.7fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trace-layer {
      animation: none;
    }
  }
</style>
